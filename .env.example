# Copy to .env and fill in. Never commit the filled-in copy.

# --- Required: the app will not start without these ---
# Signing key for JWTs. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
# Used for AI-drafted follow-up messages.
OPENAI_API_KEY=

# --- Optional ---
# Defaults to a local SQLite file. Use a managed Postgres in production;
# container filesystems are ephemeral. postgres:// URLs and libpq parameters
# such as sslmode/channel_binding are converted for asyncpg automatically.
DATABASE_URL=sqlite+aiosqlite:///careloop.db
# Without a Resend key, emails are printed to the console instead of sent.
RESEND_API_KEY=
# The sending domain must be verified in the Resend account.
RESEND_FROM_EMAIL=Careloop <noreply@mycareloop.com.ng>
# Comma-separated CORS allow-list.
ALLOWED_ORIGINS=https://mycareloop.com.ng,https://www.mycareloop.com.ng,http://localhost:8001,http://127.0.0.1:8001
LOG_LEVEL=INFO
# Set to true to log every SQL statement (noisy; logs bound parameters).
SQL_ECHO=false
